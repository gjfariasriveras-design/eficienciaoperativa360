<style>
:root{
  --navy:#1F3A5F; --navy-dark:#172E4D; --navy-10:#F0F4F9; --navy-20:#DDE7F0;
  --gold:#D4AF37; --gold-2:#B88A1B;
  --white:#FFF; --text:#1A1F2E; --text-2:#374151;
  --gray:#6B7280; --lt:#F7F9FC; --border:#E8ECF0;
  --ok:#0F766E; --ok-2:#166534; --bad:#B91C1C;
  --shadow:0 18px 45px rgba(31,58,95,.10);
  --max:1220px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:'Open Sans',sans-serif;color:var(--text);background:#fff;line-height:1.65}
.container{max-width:var(--max);margin:0 auto;padding:0 24px}
.topbar{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--border)}
.topbar-inner{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:68px}
.brand{display:flex;align-items:center;gap:14px;font-family:'Montserrat',sans-serif;text-decoration:none}
.brand-mark{font-size:26px;font-weight:800;color:var(--navy);letter-spacing:-.04em}
.brand-mark span{opacity:.35}
.brand-copy strong{display:block;font-size:13px;color:var(--navy)}
.brand-copy span{display:block;font-size:11px;color:var(--gray)}
.tab-nav{display:flex;gap:6px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
.tab-nav::-webkit-scrollbar{display:none}
.tab-btn{font-size:12px;font-weight:700;font-family:'Montserrat',sans-serif;color:var(--navy);padding:8px 14px;border-radius:999px;background:var(--navy-10);border:1px solid rgba(31,58,95,.08);text-decoration:none;cursor:pointer;white-space:nowrap;transition:background .2s,color .2s;letter-spacing:.02em}
.tab-btn:hover{background:var(--navy-20)}
.tab-btn.active{background:var(--navy);color:#fff;border-color:var(--navy)}
.hero{padding:56px 0 32px;background:linear-gradient(180deg,#fff 0%,var(--lt) 100%);position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-60px;top:-40px;width:320px;height:320px;background:radial-gradient(circle,rgba(212,175,55,.18) 0%,rgba(212,175,55,.04) 40%,rgba(212,175,55,0) 75%);pointer-events:none}
.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;background:rgba(31,58,95,.06);border:1px solid rgba(31,58,95,.08);font:800 11px 'Montserrat',sans-serif;color:var(--navy);letter-spacing:.08em;text-transform:uppercase;margin-bottom:18px}
.dot{width:8px;height:8px;border-radius:50%;background:linear-gradient(180deg,var(--gold),var(--gold-2));flex-shrink:0}
h1,h2,h3,h4{font-family:'Montserrat',sans-serif;margin:0}
h1{font-size:clamp(32px,4.5vw,52px);line-height:1.05;letter-spacing:-.03em;max-width:960px;margin-bottom:14px;color:var(--text)}
h2{font-size:clamp(26px,3.5vw,40px);line-height:1.1;letter-spacing:-.02em;color:var(--navy);margin-bottom:14px}
h3{font-size:20px;color:var(--navy);margin-bottom:10px;line-height:1.25}
.hero-sub,.section-sub{max-width:900px;font-size:17px;color:var(--gray);line-height:1.8;margin-bottom:0}
.hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:26px;align-items:start;margin-top:32px}
.card{background:#fff;border:1px solid var(--border);border-radius:20px;padding:24px;box-shadow:0 8px 24px rgba(31,58,95,.06)}
.card p{color:var(--text-2);font-size:14px;line-height:1.7;margin:0}
.card ul,.card ol{color:var(--text-2);font-size:14px;line-height:1.75;padding-left:20px}
.card li{margin-bottom:4px}
.hero-card{background:#fff;border:1px solid var(--border);border-radius:20px;overflow:hidden;box-shadow:0 12px 32px rgba(31,58,95,.07)}
.hero-card-top{background:linear-gradient(135deg,var(--navy) 0%,#274872 100%);color:#fff;padding:24px 24px 18px}
.hero-card-top h3{color:#fff;font-size:22px;margin-bottom:8px}
.hero-card-top p{font-size:14px;color:rgba(255,255,255,.82);margin:0}
.hero-card-body{padding:22px}
.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.kpi{background:#fff;border:1px solid rgba(31,58,95,.08);border-radius:16px;padding:16px;min-width:0}
.kpi .klabel{display:block;font-size:12px;color:var(--gray);margin-bottom:8px;font-family:'Montserrat',sans-serif;font-weight:600;text-transform:uppercase;letter-spacing:.06em}
.kpi .kvalue{display:block;font:800 28px 'Montserrat',sans-serif;color:var(--navy);line-height:1}
.kpi .ktrend{display:block;font-size:12px;font-weight:700;margin-top:8px;color:var(--gray)}
.section{padding:72px 0}
.section.alt{background:var(--lt)}
.section-label{font:800 11px 'Montserrat',sans-serif;color:var(--navy);letter-spacing:.16em;text-transform:uppercase;opacity:.68;margin-bottom:10px;display:block}
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.pill{display:inline-block;padding:6px 12px;border-radius:999px;background:rgba(31,58,95,.08);color:var(--navy);font-size:12px;font-weight:700;margin-bottom:12px;font-family:'Montserrat',sans-serif}
.erca-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:26px}
.erca-box{background:#fff;border:1px solid var(--border);border-radius:18px;padding:22px;position:relative;overflow:hidden;box-shadow:0 8px 20px rgba(31,58,95,.05)}
.erca-box::before{content:"";position:absolute;inset:0 auto 0 0;width:4px;background:linear-gradient(180deg,var(--gold),var(--gold-2))}
.erca-box .step{display:inline-flex;width:38px;height:38px;border-radius:50%;align-items:center;justify-content:center;background:var(--navy);color:#fff;font:800 16px 'Montserrat',sans-serif;margin-bottom:12px}
.erca-box h3{font-size:17px;margin-bottom:8px}
.erca-box p{font-size:13px;color:var(--text-2);line-height:1.65;margin:0}
.tab-panel{display:none}
.tab-panel.active{display:block;animation:fadeIn .22s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.mod-header{display:flex;align-items:flex-start;gap:18px;padding:28px 32px;background:linear-gradient(135deg,var(--navy) 0%,#274872 100%);border-radius:20px;margin-bottom:28px;position:relative;overflow:hidden}
.mod-header::after{content:attr(data-num);position:absolute;right:24px;top:50%;transform:translateY(-50%);font:800 80px 'Montserrat',sans-serif;color:rgba(255,255,255,.05);pointer-events:none;line-height:1}
.mod-icon{font-size:28px;width:54px;height:54px;background:rgba(212,175,55,.18);border:1px solid rgba(212,175,55,.28);border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mod-header h2{color:#fff;font-size:19px;margin-bottom:6px}
.mod-header p{font-size:13px;color:rgba(255,255,255,.72);margin:0;line-height:1.6}
.lessons{display:grid;gap:14px}
.lcard{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(31,58,95,.05);transition:box-shadow .2s,border-color .2s}
.lcard:hover{box-shadow:0 8px 28px rgba(31,58,95,.1);border-color:rgba(31,58,95,.18)}
.lcard.open{border-color:var(--navy);box-shadow:0 10px 36px rgba(31,58,95,.12)}
.lcard-toggle{width:100%;display:flex;align-items:center;gap:14px;padding:18px 22px;background:none;border:none;cursor:pointer;text-align:left;transition:background .15s}
.lcard-toggle:hover{background:var(--navy-10)}
.lcard.open .lcard-toggle{background:var(--navy-10)}
.lcard-num{font:800 10px 'Montserrat',sans-serif;letter-spacing:1px;color:var(--navy);background:var(--navy-10);border:1px solid rgba(31,58,95,.15);padding:4px 11px;border-radius:999px;white-space:nowrap;flex-shrink:0}
.lcard.open .lcard-num{background:var(--navy);color:#fff;border-color:var(--navy)}
.lcard-title{font:700 14px 'Montserrat',sans-serif;color:var(--navy);flex:1;text-align:left;line-height:1.3}
.lcard-arrow{width:28px;height:28px;background:var(--navy-10);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;color:var(--navy);flex-shrink:0;transition:transform .25s,background .2s;font-family:'Montserrat',sans-serif;font-weight:800}
.lcard.open .lcard-arrow{transform:rotate(180deg);background:var(--navy);color:#fff}
.lcard-body{display:none;padding:6px 22px 28px;border-top:1px solid var(--border)}
.lcard.open .lcard-body{display:block}
.blk{margin-top:22px}
.blk-label{display:inline-flex;align-items:center;gap:6px;font:800 10px 'Montserrat',sans-serif;letter-spacing:.14em;text-transform:uppercase;padding:5px 13px;border-radius:999px;margin-bottom:11px}
.lbl-e{background:rgba(31,58,95,.07);color:var(--navy);border:1px solid rgba(31,58,95,.1)}
.lbl-r{background:rgba(212,175,55,.1);color:#7a5a08;border:1px solid rgba(212,175,55,.25)}
.lbl-c{background:var(--navy);color:#fff;border:1px solid var(--navy)}
.lbl-a{background:rgba(15,118,110,.08);color:var(--ok-2);border:1px solid rgba(15,118,110,.2)}
.lbl-s{background:#eef6ff;color:var(--navy);border:1px solid var(--navy-20)}
.exp-box{background:var(--navy-10);border:1px solid var(--navy-20);border-radius:14px;padding:18px 20px;font-size:14px;color:var(--text-2);line-height:1.7}
.exp-box p+p{margin-top:8px}
.exp-box ul{list-style:none;padding:0;margin:10px 0}
.exp-box ul li{padding-left:16px;position:relative;margin-bottom:5px;font-size:13px}
.exp-box ul li::before{content:'▸';position:absolute;left:0;color:var(--navy);font-size:11px;top:1px}
.quote{font-style:italic;color:var(--navy-dark);background:#fff;border-left:3px solid var(--gold);border-radius:0 8px 8px 0;padding:11px 15px;margin:11px 0;font-size:14px;line-height:1.65;box-shadow:0 2px 8px rgba(31,58,95,.05)}
.quote-bad{border-left-color:var(--bad);color:#7f1d1d;background:#fff5f5}
.quote-good{border-left-color:var(--ok);color:#064e3b;background:#ecfdf5}
.ctx-row{display:flex;flex-wrap:wrap;gap:10px;margin:12px 0}
.ctx{background:#fff;border:1px solid var(--border);border-radius:12px;border-top:3px solid var(--gold);padding:10px 14px;font-size:13px;color:var(--text-2);line-height:1.45;box-shadow:0 2px 8px rgba(31,58,95,.04);flex:1 1 230px}
.ctx strong{display:block;font:700 9px 'Montserrat',sans-serif;letter-spacing:1.2px;text-transform:uppercase;color:var(--navy);margin-bottom:3px}
.ref-box{background:rgba(212,175,55,.07);border:1px solid rgba(212,175,55,.22);border-radius:14px;padding:16px 20px}
.ref-q{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--text);margin-bottom:7px;line-height:1.6}
.ref-q:last-child{margin-bottom:0}
.ref-q::before{content:"?";font:800 10px 'Montserrat',sans-serif;color:#fff;background:linear-gradient(180deg,var(--gold),var(--gold-2));width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px}
.con-box{background:linear-gradient(135deg,var(--navy) 0%,#274872 100%);border-radius:14px;padding:18px 20px;display:flex;gap:14px;align-items:flex-start}
.con-icon{font-size:22px;width:44px;height:44px;background:rgba(212,175,55,.18);border:1px solid rgba(212,175,55,.28);border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.con-txt{font-size:14px;color:rgba(255,255,255,.88);line-height:1.75;flex:1}
.con-txt strong,.con-txt b{color:#fff;font-weight:700}
.con-txt ul{margin:8px 0 0 0;padding-left:18px}
.contrast{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.c-bad{padding:11px 14px;font-size:13px;line-height:1.55;background:#fff5f5;border-radius:10px;border-left:3px solid var(--bad);color:#7f1d1d}
.c-good{padding:11px 14px;font-size:13px;line-height:1.55;background:#ecfdf5;border-radius:10px;border-left:3px solid var(--ok);color:#064e3b}
.c-lbl{font:800 9px 'Montserrat',sans-serif;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:4px;opacity:.65}
.apl-box{background:var(--lt);border:1px solid var(--border);border-radius:14px;padding:18px 20px}
.steps{list-style:none!important;padding:0!important;display:grid;gap:8px;margin:0!important}
.steps li{display:flex!important;align-items:flex-start;gap:10px;font-size:14px;color:var(--text-2);line-height:1.6}
.steps li strong{color:var(--navy)}
.sn{width:24px;height:24px;border-radius:50%;background:var(--navy);color:#fff;font:800 10px 'Montserrat',sans-serif;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.si{font-size:15px;flex-shrink:0;margin-top:1px;line-height:1.4;color:var(--ok-2)}
.pills-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.fpill{display:flex;align-items:baseline;gap:6px;background:#fff;border:1px solid rgba(31,58,95,.12);border-radius:999px;padding:7px 14px;font-size:13px;color:var(--text-2);box-shadow:0 2px 6px rgba(31,58,95,.04)}
.fpill strong{font:700 9px 'Montserrat',sans-serif;letter-spacing:1px;text-transform:uppercase;color:var(--navy)}
.key-action{background:linear-gradient(135deg,rgba(31,58,95,.06) 0%,rgba(31,58,95,.03) 100%);border:1px solid rgba(31,58,95,.14);border-left:4px solid var(--gold);border-radius:0 12px 12px 0;padding:13px 16px;font-size:14px;color:var(--navy);font-weight:600;line-height:1.55;margin-top:12px}
.resp-box{background:#fff;border:1px solid var(--navy-20);border-left:4px solid var(--navy);border-radius:0 12px 12px 0;padding:14px 16px;color:var(--navy);font-size:14px;font-weight:700;line-height:1.6;box-shadow:0 2px 8px rgba(31,58,95,.04)}
.data-table{width:100%;border-collapse:collapse;background:#fff;border-radius:14px;overflow:hidden;border:1px solid var(--border);margin-top:12px;font-size:13px;color:var(--text-2)}
.data-table th{background:var(--navy);color:#fff;text-align:left;font-family:'Montserrat',sans-serif;font-size:12px;padding:10px 12px}
.data-table td{padding:10px 12px;border-top:1px solid var(--border)}
.data-table tr:nth-child(even) td{background:#FAFBFD}
.footer{padding:36px 0 48px;background:#fff;border-top:1px solid var(--border);text-align:center}
.footer p{font-size:13px;color:var(--gray);margin:4px 0}
.footer strong{color:var(--navy)}
.contact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:24px}
.contact-box{background:var(--lt);border:1px solid var(--border);border-radius:16px;padding:16px;text-align:left}
.contact-box small{display:block;font:800 10px 'Montserrat',sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--navy);opacity:.6;margin-bottom:6px}
.contact-box strong{display:block;font-size:14px;color:var(--navy);font-family:'Montserrat',sans-serif}
@media(max-width:1180px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:1024px){.hero-grid,.grid-2,.grid-3,.grid-4,.erca-grid,.contact-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){
  .topbar-inner{flex-wrap:wrap;padding:12px 0;gap:12px}
  .hero{padding-top:36px}h1{font-size:32px}h2{font-size:26px}
  .hero-grid,.grid-2,.grid-3,.grid-4,.erca-grid,.kpis,.contact-grid,.contrast{grid-template-columns:1fr}
  .container{padding:0 16px}.section{padding:52px 0}
  .mod-header{padding:20px 20px;flex-direction:column;gap:12px}
  .tab-nav{gap:4px}
}

/* EO360 · Ajustes de gobierno del control administrativo */
.control-flow{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-top:16px}
.control-node{background:#fff;border:1px solid var(--border);border-top:4px solid var(--gold);border-radius:14px;padding:14px;box-shadow:0 4px 14px rgba(31,58,95,.05);min-height:110px}
.control-node strong{display:block;font:800 12px 'Montserrat',sans-serif;color:var(--navy);margin-bottom:6px}
.control-node span{display:block;font-size:13px;color:var(--text-2);line-height:1.5}
.template-box{background:#fff;border:1px solid var(--border);border-radius:14px;padding:16px;margin-top:14px;box-shadow:0 4px 14px rgba(31,58,95,.04)}
.template-title{font:800 12px 'Montserrat',sans-serif;color:var(--navy);letter-spacing:.08em;text-transform:uppercase;margin-bottom:10px}
.template-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.template-field{border:1px dashed var(--navy-20);border-radius:10px;padding:10px 12px;background:#FAFBFD;min-height:54px}
.template-field strong{display:block;font:800 10px 'Montserrat',sans-serif;color:var(--navy);letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px}
.template-field span{color:var(--text-2);font-size:13px}
@media(max-width:1024px){.control-flow{grid-template-columns:1fr 1fr}.template-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.control-flow,.template-grid{grid-template-columns:1fr}}


